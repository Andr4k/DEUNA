<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Este servicio no usa Entity Framework ni MassTransit a propósito: no tiene
    modelo de escritura ni consume eventos. Su único trabajo es LEER agregados de
    las bases de los otros servicios con SQL, y para eso Dapper es la herramienta
    directa: mapea filas a registros sin ceremonia.
  -->
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.*" />
    <PackageReference Include="Npgsql" Version="9.0.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deuna.Shared\Deuna.Shared.csproj" />
  </ItemGroup>

</Project>
