### Variables
@baseUrl = http://localhost:5002
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (obtener desde login en Identity Service)

### 1. Crear Pedido (Caso Exitoso)
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "restauranteId": "a1b2c3d4-5e6f-7g8h-9i0j-k1l2m3n4o5p6",
  "items": [
    {
      "nombreProducto": "Hamburguesa Clásica",
      "descripcion": "Carne 180g, queso, lechuga, tomate, cebolla, salsa especial",
      "cantidad": 2,
      "precioUnitario": 25000
    },
    {
      "nombreProducto": "Papas Fritas Grandes",
      "descripcion": "Porción grande con salsa ketchup y mayonesa",
      "cantidad": 1,
      "precioUnitario": 12000
    },
    {
      "nombreProducto": "Gaseosa 500ml",
      "descripcion": "Coca-Cola, Sprite o Fanta",
      "cantidad": 2,
      "precioUnitario": 5000
    }
  ],
  "direccionEntrega": {
    "calle": "Calle 45",
    "numero": "#23-10",
    "interior": "Apto 301",
    "referencia": "Edificio Torres del Parque, torre 2",
    "ciudad": "Bogotá",
    "departamento": "Cundinamarca",
    "codigoPostal": "110111",
    "latitud": 4.6097100,
    "longitud": -74.0817500
  },
  "contactos": [
    {
      "tipo": "Cliente",
      "nombre": "Juan Pérez",
      "telefono": "+573001234567",
      "email": "juan.perez@email.com"
    },
    {
      "tipo": "Restaurante",
      "nombre": "Demo Restaurant",
      "telefono": "+5712345678",
      "email": "pedidos@demorestaurant.com"
    }
  ],
  "notasCliente": "Sin cebolla en las hamburguesas, por favor"
}

### Expected Response (201 Created)
# {
#   "pedidoId": "b2c3d4e5-6f7g-8h9i-0j1k-l2m3n4o5p6q7",
